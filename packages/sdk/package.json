{
  "name": "@payccount/js",
  "version": "0.1.0",
  "private": true,
  "description": "payCcount 加盟店向け JS SDK（デモ）— Checkout Session 作成、決済・返金、Webhook 署名検証",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./webhooks": {
      "types": "./src/webhooks.ts",
      "default": "./src/webhooks.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./webhooks": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@payccount/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
