# ============================================================================
# payCcount 環境変数（デモ）
#   apps/api  : .dev.vars（wrangler dev）または Cloudflare の環境変数に設定
#   apps/web  : .env.local（VITE_ 接頭辞のみフロントに露出）
# ============================================================================

# ---------- apps/api（Hono / Cloudflare Workers） ----------
# DB 接続。どちらか一方を設定する。
#   (A) Supabase: PostgREST 経由で RPC を呼ぶ（本番想定）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
#   (B) ローカル Postgres: pnpm db:start で表示される URL（Workers では nodejs_compat が必要）
# DATABASE_URL=postgres://payccount:payccount@127.0.0.1:54329/payccount

# 認証モード
#   supabase … Supabase Auth の JWT を検証（JWT_SECRET に Supabase の JWT Secret を入れる。未設定なら JWKS を使う）
#   demo     … メールアドレスだけでログインできるデモ認証（ローカル Postgres 向け）。JWT_SECRET 必須
AUTH_MODE=supabase
JWT_SECRET=change-me-to-a-long-random-string

# フロントの URL（Checkout URL の生成・CORS）
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# モック用エンドポイント（/mock/*）を有効にする（開発時のみ true）
DEMO_MOCK_ENDPOINTS=true

# レート供給: mock（シード値）| live（Frankfurter + CoinGecko の無認証 API、5 分ごと）
RATES_PROVIDER=mock

# ---------- apps/web（Vite） ----------
VITE_API_URL=http://localhost:8787
# Supabase Auth を使う場合（未設定ならデモ認証にフォールバック）
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------- apps/shop-jp / apps/shop-global（Cloudflare Pages Functions） ----------
# 加盟店ダッシュボードで発行した値を .dev.vars に設定する
PAYCCOUNT_API_URL=http://localhost:8787
PAYCCOUNT_SECRET_KEY=sk_test_...
PAYCCOUNT_WEBHOOK_SECRET=whsec_...

# ---------- scripts/ledger-verify.ts ----------
# DATABASE_URL（上と同じ）を使う
